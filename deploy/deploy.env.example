# Copy this file to ../.deploy.env and fill in your cPanel FTP details.
# cPanel normally uses explicit FTPS: ftp:// on port 21 plus FTP_TLS=true.

FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=cpanel_ftp_user
FTP_REMOTE_ROOT=public_html
FTP_SCHEME=ftp
FTP_TLS=true

# Keep certificate verification enabled. Only set this temporarily if your
# hosting provider uses a certificate that your computer cannot verify.
FTP_INSECURE=false

# Prefer the password prompt. For unattended use, FTP_PASSWORD may be set here,
# but .deploy.env must remain private and must never be committed.
# FTP_PASSWORD=replace_me

