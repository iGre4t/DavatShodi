<Application x:Class="DavatShodi.GuestManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1D96E1" />
    <FontFamily x:Key="PanelFont">/DavatShodi.GuestManager;component/Assets/Fonts/#PeydaWeb(FaNum)</FontFamily>
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="{StaticResource PanelFont}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource PanelFont}" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource PanelFont}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource PanelFont}" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="FontFamily" Value="{StaticResource PanelFont}" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="FontFamily" Value="{StaticResource PanelFont}" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="{StaticResource PanelFont}" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="FontFamily" Value="{StaticResource PanelFont}" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="FontFamily" Value="{StaticResource PanelFont}" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="FontFamily" Value="{StaticResource PanelFont}" />
    </Style>
  </Application.Resources>
</Application>
