<Window x:Class="DavatShodi.GuestManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCI Event Guest Manager" Width="430" SizeToContent="Height" MinHeight="650"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FlowDirection="LeftToRight" FontFamily="{StaticResource PanelFont}" Background="#F5F6F8"
        Icon="/DavatShodi.GuestManager;component/Assets/Brand/HamrahIcon.ico">
  <Grid Margin="38" FlowDirection="RightToLeft">
    <Border Padding="30" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="16">
      <StackPanel VerticalAlignment="Center">
        <Border x:Name="BrandLogoBorder" Width="72" Height="72" CornerRadius="16" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center">
          <Grid>
            <TextBlock x:Name="BrandLogoText" Text="EGM" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" />
            <Image x:Name="BrandLogoImage" Visibility="Collapsed" Stretch="Uniform" Margin="5" />
          </Grid>
        </Border>
        <TextBlock x:Name="PanelNameText" Margin="0,20,0,4" Text="مدیریت مهمانان رویداد" FontSize="22" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Margin="0,0,0,26" Text="برای شروع وارد حساب کاربری پنل شوید" Foreground="#667085" TextAlignment="Center" />

        <TextBlock Text="نام کاربری" FontWeight="SemiBold" />
        <TextBox x:Name="UsernameBox" Margin="0,7,0,16" FlowDirection="LeftToRight" KeyDown="UsernameBox_KeyDown" />
        <TextBlock Text="رمز عبور" FontWeight="SemiBold" />
        <PasswordBox x:Name="PasswordBox" Margin="0,7,0,12" Padding="10,8" FontSize="14" FlowDirection="LeftToRight" KeyDown="PasswordBox_KeyDown" />
        <CheckBox x:Name="RememberPasswordCheckBox" Margin="0,0,0,18" Content="نام کاربری و رمز عبور ذخیره شود" Foreground="#475467" />

        <TextBlock x:Name="ErrorText" MinHeight="22" Margin="0,0,0,8" Foreground="#B42318" TextWrapping="Wrap" TextAlignment="Center" />
        <Button x:Name="LoginButton" Content="ورود" Height="44" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" Click="LoginButton_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
