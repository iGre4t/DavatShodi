<Window x:Class="DavatShodi.GuestManager.Views.TicketNumberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Number of Ticket" Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource PanelFont}" Background="#F7F9FC">
  <Border Margin="18" Padding="22" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14">
    <StackPanel>
      <TextBlock x:Name="TicketTitleText" Text="Number of Ticket" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" TextWrapping="Wrap" />
      <TextBlock x:Name="GuestText" Margin="0,7,0,16" Foreground="#667085" TextWrapping="Wrap" />
      <TextBox x:Name="TicketNumberBox" Height="52" FontSize="22" TextAlignment="Center" FlowDirection="LeftToRight"
               VerticalContentAlignment="Center" PreviewTextInput="TicketNumberBox_PreviewTextInput" />
      <TextBlock x:Name="ErrorText" Margin="0,6,0,0" Foreground="#D92D20" Visibility="Collapsed" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
        <Button Content="ثبت و چاپ" Width="150" MinHeight="44" Padding="16,8" IsDefault="True" Click="Confirm_Click"
                Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" />
        <Button Content="انصراف" Width="100" MinHeight="44" Padding="16,8" Margin="10,0,0,0" IsCancel="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
