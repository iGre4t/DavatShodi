<Window x:Class="DavatShodi.GuestManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCI Event Guest Manager" MinWidth="900" MinHeight="650" Width="1120" Height="760"
        WindowStartupLocation="CenterScreen" FlowDirection="LeftToRight" FontFamily="{StaticResource PanelFont}" Background="#F5F6F8"
        Icon="/DavatShodi.GuestManager;component/Assets/Brand/HamrahIcon.ico">
  <Window.Resources>
    <FontFamily x:Key="SidebarIconFont">/DavatShodi.GuestManager;component/Assets/Fonts/#remixicon</FontFamily>
    <Style x:Key="ThinSidebarIcon" TargetType="Path">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="AdminLockButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Opacity" Value="0.34" />
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#D0D5DD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Opacity" Value="0.95" />
          <Setter Property="Background" Value="#EEF4FF" />
          <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid FlowDirection="RightToLeft">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="72" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#101828" BorderBrush="#1D2939" BorderThickness="0,0,1,0">
      <Grid Margin="10,18" FlowDirection="LeftToRight">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <Border x:Name="SidebarLogoBorder" Width="42" Height="42" Margin="0,0,0,24" CornerRadius="11" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center">
            <Grid>
              <TextBlock x:Name="SidebarLogoText" Text="EGM" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image x:Name="SidebarLogoImage" Visibility="Collapsed" Stretch="Uniform" Margin="3" />
            </Grid>
          </Border>
          <Button x:Name="ScanNavButton" Width="48" Height="48" Margin="0,0,0,10" Padding="0" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" ToolTip="اسکن" Click="ScanNavButton_Click">
            <Path Style="{StaticResource ThinSidebarIcon}" Data="M 8,3 H 3 V 8 M 16,3 H 21 V 8 M 3,16 V 21 H 8 M 16,21 H 21 V 16 M 7,12 H 17 M 8,8 V 10 M 12,8 V 10 M 16,8 V 10 M 8,14 V 16 M 12,14 V 16 M 16,14 V 16" />
          </Button>
          <Button x:Name="EventInfoNavButton" Width="48" Height="48" Margin="0,0,0,10" Padding="0" Background="Transparent" Foreground="#98A2B3" BorderThickness="0" ToolTip="اطلاعات رویداد" Click="EventInfoNavButton_Click">
            <Path Style="{StaticResource ThinSidebarIcon}" Data="M 12,2 A 10,10 0 1 1 12,22 A 10,10 0 1 1 12,2 M 12,11 V 17 M 12,7 V 7.25" />
          </Button>
          <Button x:Name="PrinterNavButton" Width="48" Height="48" Margin="0,0,0,10" Padding="0" Background="Transparent" Foreground="#98A2B3" BorderThickness="0" ToolTip="چاپگر" Click="PrinterNavButton_Click">
            <Path Style="{StaticResource ThinSidebarIcon}" Data="M 6,8 V 3 H 18 V 8 M 6,17 H 3 V 8 H 21 V 17 H 18 M 6,14 H 18 V 21 H 6 Z M 17,11 H 18" />
          </Button>
          <Button x:Name="SettingsNavButton" Width="48" Height="48" Padding="0" Background="Transparent" Foreground="#98A2B3" BorderThickness="0" ToolTip="تنظیمات" Click="SettingsNavButton_Click">
            <Path Style="{StaticResource ThinSidebarIcon}" Data="M 3,5 H 7 M 11,5 H 21 M 3,12 H 14 M 18,12 H 21 M 3,19 H 6 M 10,19 H 21 M 7,2 H 11 V 8 H 7 Z M 14,9 H 18 V 15 H 14 Z M 6,16 H 10 V 22 H 6 Z" />
          </Button>
        </StackPanel>
        <Button Grid.Row="2" Width="48" Height="48" Padding="0" Background="#D92D20" Foreground="White" BorderBrush="#F04438" BorderThickness="1" ToolTip="خروج از حساب" Click="LogoutButton_Click">
          <Path Style="{StaticResource ThinSidebarIcon}" Data="M 10,3 H 3 V 21 H 10 M 9,12 H 21 M 17,8 L 21,12 L 17,16" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1" Padding="24,12">
      <DockPanel LastChildFill="False" FlowDirection="LeftToRight">
        <Button x:Name="HeaderLockButton" DockPanel.Dock="Left" Tag="scan" Style="{StaticResource AdminLockButtonStyle}" VerticalAlignment="Center" Margin="0,0,12,0" Click="PageLockButton_Click">
          <TextBlock x:Name="HeaderLockIcon" Text="&#xE785;" FontFamily="Segoe Fluent Icons" FontSize="15" />
        </Button>
        <StackPanel DockPanel.Dock="Right" FlowDirection="RightToLeft" VerticalAlignment="Center">
          <TextBlock x:Name="MainPanelNameText" Text="مدیریت ورود مهمانان" FontSize="19" FontWeight="Bold" />
          <TextBlock x:Name="HeaderEventText" Text="در حال دریافت اطلاعات رویداد..." Margin="0,4,0,0" Foreground="#667085" FontSize="11" />
          <TextBlock x:Name="LiveSyncText" Text="همگام‌سازی زنده هر ۲ ثانیه" Margin="0,3,0,0" Foreground="#667085" FontSize="10" />
        </StackPanel>

        <Border DockPanel.Dock="Left" Padding="10,7" Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
            <Border Width="34" Height="34" Background="#EAF6FD" CornerRadius="17">
              <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" FlowDirection="RightToLeft">
              <TextBlock Text="اپراتور فعال" Foreground="#667085" FontSize="9" />
              <TextBlock x:Name="UserText" Margin="0,2,0,0" Foreground="#344054" FontSize="12" FontWeight="Bold" />
            </StackPanel>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <ScrollViewer x:Name="EventInfoPage" Grid.Row="1" Visibility="Collapsed" Margin="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14">
        <Grid>
          <Border Height="4" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Top" CornerRadius="14,14,0,0" />
          <Grid Margin="24,26,24,20">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,20">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="پنل کنترل مهمان" Foreground="#667085" FontWeight="SemiBold" />
                <TextBlock x:Name="EventHeroNameText" Text="EGM" Margin="0,3,0,0" FontSize="25" FontWeight="Bold" />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                  <TextBlock Text="بازه رویداد فعال:" Foreground="#667085" />
                  <TextBlock x:Name="PeriodTitleText" Text="بدون بازه فعال" Margin="5,0,0,0" Foreground="#475467" FontWeight="Bold" />
                </StackPanel>
              </StackPanel>
              <Border x:Name="PhasePillBorder" Grid.Column="1" Padding="14,9" Background="#ECFDF3" BorderBrush="#ABEFC6" BorderThickness="1" CornerRadius="10" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                  <Ellipse x:Name="PhasePillDot" Width="9" Height="9" Margin="0,0,8,0" Fill="#087443" VerticalAlignment="Center" />
                  <TextBlock x:Name="PhaseText" Text="در حال دریافت وضعیت..." Foreground="#087443" FontWeight="Bold" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="1" Padding="14" Background="#F8FAFC" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.35*" />
                  <ColumnDefinition Width="0.85*" />
                  <ColumnDefinition Width="0.85*" />
                  <ColumnDefinition Width="0.85*" />
                  <ColumnDefinition Width="1.8*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,0,0" Padding="14" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="9">
                  <StackPanel>
                    <TextBlock Text="ورود مهمانان" Foreground="#475467" FontWeight="Bold" />
                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" Margin="0,0,7,0" Fill="#1849A9" VerticalAlignment="Center" />
                      <TextBlock x:Name="EntrySummaryText" Text="۰ از ۰ نفر دعوت‌شده" Foreground="#475467" />
                    </StackPanel>
                    <ProgressBar x:Name="EntryProgressBar" Height="7" Margin="0,12,0,8" Minimum="0" Maximum="1" Value="0" Background="#E7EDF4" Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0" />
                    <TextBlock x:Name="EntryCompositionText" Text="دعوت همین بازه ۰  •  دعوت بازه دیگر ۰  •  بدون دعوت ۰" Foreground="#667085" FontSize="10" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="10,0,0,0" Padding="10" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="9">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="مانده تا ورود" Foreground="#667085" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock x:Name="WaitingText" Text="۰" Margin="0,8,0,3" Foreground="#A15C00" FontSize="23" FontWeight="Bold" TextAlignment="Center" />
                    <Ellipse Width="7" Height="7" Fill="#DDA500" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="2" Margin="10,0,0,0" Padding="10" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="9">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="اکنون داخل" Foreground="#667085" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock x:Name="InsideText" Text="۰" Margin="0,8,0,3" Foreground="#087443" FontSize="23" FontWeight="Bold" TextAlignment="Center" />
                    <Ellipse Width="7" Height="7" Fill="#079455" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="3" Margin="10,0,0,0" Padding="10" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="9">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="خروج ثبت‌شده" Foreground="#667085" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock x:Name="QuitText" Text="۰" Margin="0,8,0,3" Foreground="#5925DC" FontSize="23" FontWeight="Bold" TextAlignment="Center" />
                    <Ellipse Width="7" Height="7" Fill="#6938EF" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="4" Margin="10,0,0,0" Padding="13" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="9">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="تفکیک ورود براساس جنسیت" Foreground="#475467" FontSize="11" FontWeight="Bold" />
                    <Grid Margin="0,11,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="55" /></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="مرد" FontSize="11" FontWeight="Bold" />
                      <ProgressBar x:Name="MaleProgressBar" Grid.Column="1" Height="6" Margin="8,0" Minimum="0" Maximum="1" Value="0" Background="#E7EDF4" Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0" VerticalAlignment="Center" />
                      <TextBlock x:Name="MaleStatsText" Grid.Column="2" Text="۰ از ۰" Foreground="#667085" FontSize="10" TextAlignment="Left" />
                    </Grid>
                    <Grid Margin="0,9,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="55" /></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="زن" FontSize="11" FontWeight="Bold" />
                      <ProgressBar x:Name="FemaleProgressBar" Grid.Column="1" Height="6" Margin="8,0" Minimum="0" Maximum="1" Value="0" Background="#E7EDF4" Foreground="#BF6AB1" BorderThickness="0" VerticalAlignment="Center" />
                      <TextBlock x:Name="FemaleStatsText" Grid.Column="2" Text="۰ از ۰" Foreground="#667085" FontSize="10" TextAlignment="Left" />
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,20,0,0">
              <TextBlock Text="جمع بلیت‌های ثبت‌شده در بازه جاری" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
              <TextBlock x:Name="TicketTotalsEmpty" Text="آمار بلیت برای بازه جاری در دسترس نیست." Foreground="#667085" />
              <ItemsControl x:Name="TicketTotalsItems">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border Padding="18,12" Margin="0,0,10,10" MinWidth="180" Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10">
                    <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="240" /><TextBlock Text="{Binding Sum}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="240" /></StackPanel>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Padding="18" Margin="0,12,0,12" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                  <TextBlock Text="جمع بلیت‌های دستی — فقط این دستگاه" FontSize="16" FontWeight="Bold" />
                  <TextBlock Text="مستقل از آمار سرور؛ جمع اعداد بلیت‌های ارسال‌شده به صف چاپ در این رویداد" Foreground="#667085" TextWrapping="Wrap" Margin="0,6,0,12" />
                  <TextBlock x:Name="ManualTicketTotalsEmpty" Text="هنوز بلیت دستی ثبت نشده است." Foreground="#667085" TextWrapping="Wrap" />
                  <ItemsControl x:Name="ManualTicketTotalsItems">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Border Padding="18,12" Margin="0,0,10,10" MinWidth="180" Background="#F8FAFC" CornerRadius="10">
                        <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="240" /><TextBlock Text="{Binding Sum}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="240" /></StackPanel>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <TextBlock Text="تفکیک ورود براساس گروه — بازه جاری" FontSize="16" FontWeight="Bold" Margin="0,14,0,12" />
              <TextBlock x:Name="GroupProgressEmpty" Text="گروهی برای نمایش در دسترس نیست." Foreground="#667085" />
              <ItemsControl x:Name="GroupProgressItems">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border Padding="14" Margin="0,0,0,10" Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <ProgressBar Grid.Column="1" Height="7" Margin="16,0" Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding Entered}" Background="#E7EDF4" Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Caption}" Foreground="#667085" TextAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

    </Grid>
    </ScrollViewer>

      <Grid x:Name="ScanPage" Grid.Row="1" Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,14" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="22">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="کد ملی یا کد پرسنلی" FontSize="15" FontWeight="SemiBold" />
              <TextBox x:Name="ScanBox" Height="64" Margin="0,9,0,0" MaxLength="10" FlowDirection="LeftToRight" TextAlignment="Center" FontSize="27" FontWeight="Bold" PreviewTextInput="ScanBox_PreviewTextInput" KeyDown="ScanBox_KeyDown" TextChanged="ScanBox_TextChanged" />
              <TextBlock Text="اسکنر را استفاده کنید یا شناسه را بنویسید و Enter بزنید." Margin="0,7,0,0" Foreground="#667085" FontSize="11" />
              <Button x:Name="ManualTicketButton" Content="چاپ دستی بلیت مهمان" Click="ManualTicketButton_Click" HorizontalAlignment="Right" Margin="0,12,0,0" MinHeight="40" Padding="16,8" />
            </StackPanel>
            <Border Grid.Column="2" x:Name="ResultBorder" MinHeight="98" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="3,0,0,0" CornerRadius="7" Padding="20">
              <TextBlock x:Name="ResultText" Text="شناسه مهمان را اسکن کنید." TextWrapping="Wrap" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" />
            </Border>
          </Grid>
        </Border>

        <Border x:Name="LogsPanel" Grid.Row="1" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12" FlowDirection="LeftToRight">
              <StackPanel DockPanel.Dock="Right" FlowDirection="RightToLeft">
                <TextBlock Text="گزارش کل مهمانان" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="جستجو در همه گزارش‌ها" Margin="0,5,0,0" FontSize="12" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock DockPanel.Dock="Left" Text="جدیدترین موارد در بالا" Foreground="#667085" FontSize="11" FlowDirection="RightToLeft" VerticalAlignment="Top" />
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Height="43" Background="White" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="9">
                <Grid>
                  <TextBox x:Name="LogsSearchBox" Padding="38,8,12,8" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12" TextChanged="LogsSearchBox_TextChanged" />
                  <TextBlock Text="نام، کد ملی، کد پرسنلی، شماره مهمان، وضعیت، بازه، واحد یا تاریخ" Margin="40,0,12,0" Foreground="#98A2B3" IsHitTestVisible="False" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=LogsSearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#667085" HorizontalAlignment="Right" Margin="0,0,13,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
              </Border>
              <TextBlock x:Name="LogsCountText" Grid.Column="1" Text="۰ نتیجه" Foreground="#667085" FontSize="11" TextAlignment="Left" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="2" Margin="0,0,0,2" Padding="12,10" Background="#F6F7F9" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="21*" /><ColumnDefinition Width="28*" /><ColumnDefinition Width="21*" /><ColumnDefinition Width="17*" /><ColumnDefinition Width="13*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="وضعیت" Foreground="#667085" FontSize="11" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="مهمان" Foreground="#667085" FontSize="11" FontWeight="Bold" />
                <TextBlock Grid.Column="2" Text="آخرین عملیات" Foreground="#667085" FontSize="11" FontWeight="Bold" />
                <TextBlock Grid.Column="3" Text="وضعیت حضور" Foreground="#667085" FontSize="11" FontWeight="Bold" />
                <TextBlock Grid.Column="4" Text="عملیات" Foreground="#667085" FontSize="11" FontWeight="Bold" />
              </Grid>
            </Border>

            <Grid Grid.Row="3">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="LogsItemsControl">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="LogCard" Margin="0,6,0,0" Background="White" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="11">
                        <Grid>
                          <Border x:Name="LogAccent" Width="5" HorizontalAlignment="Right" Background="#DF4052" CornerRadius="0,10,10,0" />
                          <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="10,4,10,4">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="21*" /><ColumnDefinition Width="28*" /><ColumnDefinition Width="21*" /><ColumnDefinition Width="17*" /><ColumnDefinition Width="13*" />
                              </Grid.ColumnDefinitions>

                              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" Fill="#DF4052" />
                                <Border x:Name="StatusBadge" Padding="10,5" Background="#FFF0F2" CornerRadius="15">
                                  <TextBlock x:Name="StatusBadgeText" Text="{Binding StatusLabel}" Foreground="#C72C41" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" />
                                </Border>
                              </StackPanel>

                              <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                <Button Content="{Binding DisplayName}" Padding="0" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#175CD3" FontWeight="Bold" Cursor="Hand" ToolTip="نمایش اطلاعات مهمان" Click="GuestDetailsButton_Click" />
                                <TextBlock Text="{Binding IdentifierLabel}" Margin="0,5,0,0" Foreground="#667085" FontSize="10" FlowDirection="RightToLeft" />
                              </StackPanel>

                              <StackPanel Grid.Column="2" Margin="8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OperationLabel}" FontWeight="Bold" />
                                <TextBlock Text="{Binding OperationAt}" Margin="0,5,0,0" Foreground="#475467" FontFamily="Consolas" FontSize="10" FlowDirection="LeftToRight" TextAlignment="Right" />
                              </StackPanel>

                              <TextBlock Grid.Column="3" Margin="8,0" Text="{Binding AttendanceStateLabel}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                              <StackPanel Grid.Column="4" Margin="4,3" VerticalAlignment="Center">
                                <Button x:Name="RegisterUninvitedButton" Content="ثبت مهمان ناخوانده" Padding="7,5" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" FontSize="9" FontWeight="Bold" Click="RegisterUninvitedButton_Click">
                                  <Button.Style>
                                    <Style TargetType="Button">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                      <Style.Triggers><DataTrigger Binding="{Binding CanRegisterUninvited}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                  </Button.Style>
                                </Button>
                                <Button x:Name="ForceAttendanceButton" Content="{Binding ForceButtonLabel}" Margin="0,4,0,0" Padding="7,5" Background="#FFF7ED" Foreground="#9A3412" BorderBrush="#B45309" BorderThickness="1" FontSize="9" FontWeight="Bold" Click="ForceAttendanceButton_Click">
                                  <Button.Style>
                                    <Style TargetType="Button">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                      <Style.Triggers><DataTrigger Binding="{Binding CanForceAttendance}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                  </Button.Style>
                                </Button>
                                <Button x:Name="PrintCardButton" Content="چاپ مجدد" Margin="0,4,0,0" Padding="7,5" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" FontSize="9" FontWeight="Bold" Click="PrintCardButton_Click">
                                  <Button.Style>
                                    <Style TargetType="Button">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                      <Style.Triggers><DataTrigger Binding="{Binding CanPrintCard}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                  </Button.Style>
                                </Button>
                                <TextBlock x:Name="NoLogActionText" Text="—" FontSize="16" HorizontalAlignment="Center">
                                  <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                      <Setter Property="Visibility" Value="Visible" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanRegisterUninvited}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        <DataTrigger Binding="{Binding CanForceAttendance}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        <DataTrigger Binding="{Binding CanPrintCard}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </TextBlock.Style>
                                </TextBlock>
                              </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Padding="12,9" Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10">
                              <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Message}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" Orientation="Horizontal">
                                  <TextBlock Text="بازه: " Foreground="#667085" FontSize="10" />
                                  <TextBlock Text="{Binding PeriodLabel}" FontSize="10" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="18,0,0,0" Orientation="Horizontal">
                                  <TextBlock Text="بررسی: " Foreground="#667085" FontSize="10" />
                                  <TextBlock Text="{Binding AttemptedAt}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" FlowDirection="LeftToRight" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </Grid>
                        </Grid>
                      </Border>
                      <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding StatusTone}" Value="success">
                            <Setter TargetName="LogAccent" Property="Background" Value="#18A566" />
                            <Setter TargetName="StatusDot" Property="Fill" Value="#18A566" />
                            <Setter TargetName="StatusBadge" Property="Background" Value="#ECFDF3" />
                            <Setter TargetName="StatusBadgeText" Property="Foreground" Value="#087443" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding StatusTone}" Value="duplicate">
                            <Setter TargetName="LogAccent" Property="Background" Value="#D59A12" />
                            <Setter TargetName="StatusDot" Property="Fill" Value="#D59A12" />
                            <Setter TargetName="StatusBadge" Property="Background" Value="#FFF8E6" />
                            <Setter TargetName="StatusBadgeText" Property="Foreground" Value="#805900" />
                          </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock x:Name="LogsEmptyText" Text="هنوز موردی بررسی نشده است." Foreground="#667085" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <Grid x:Name="PrinterPage" Grid.Row="1" Visibility="Collapsed" Margin="24" FlowDirection="LeftToRight">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="32">
          <StackPanel Width="560" HorizontalAlignment="Right" VerticalAlignment="Top" FlowDirection="RightToLeft">
            <TextBlock Text="تنظیمات چاپگر Print Card" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="این انتخاب‌ها فقط روی همین رایانه ذخیره می‌شوند." Margin="0,5,0,12" Foreground="#667085" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
              <Button x:Name="RefreshPrintersButton" Content="به‌روزرسانی فهرست چاپگرها" Height="38" Padding="14,0" Background="#F9FAFB" BorderBrush="#D0D5DD" Click="RefreshPrintersButton_Click" />
              <TextBlock x:Name="PrinterRefreshStatus" Margin="12,0,0,0" Foreground="#667085" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="چاپگر اصلی" FontWeight="SemiBold" />
            <ComboBox x:Name="PrimaryPrinterCombo" Height="44" Margin="0,8,0,20" FlowDirection="LeftToRight" HorizontalContentAlignment="Right" SelectionChanged="PrinterSelectionChanged" />
            <CheckBox x:Name="UseSecondPrinterCheck" Content="برای نسخه دوم از چاپگر دیگری استفاده شود" Margin="0,0,0,16" Checked="PrinterSelectionChanged" Unchecked="PrinterSelectionChanged" />
            <TextBlock Text="چاپگر نسخه دوم" FontWeight="SemiBold" />
            <ComboBox x:Name="SecondaryPrinterCombo" Height="44" Margin="0,8,0,18" FlowDirection="LeftToRight" HorizontalContentAlignment="Right" SelectionChanged="PrinterSelectionChanged" />
            <TextBlock Text="چاپگر Custom Number Ticket" FontWeight="SemiBold" Margin="0,4,0,0" />
            <StackPanel x:Name="TicketPrintersPanel" Margin="0,8,0,18" />
            <TextBlock Text="رفتار چاپ پس از ورود موفق" FontWeight="SemiBold" Margin="0,2,0,10" />
            <CheckBox x:Name="AutoPrintCheck" Content="چاپ خودکار همه خروجی‌های فعال" Margin="0,0,0,10" />
            <CheckBox x:Name="DoublePrintCheck" Content="چاپ دو نسخه از Print Card" Margin="0,0,0,10" />
            <CheckBox x:Name="TicketActiveCheck" Content="دریافت Number of Ticket و چاپ رسیدها" Margin="0,0,0,10" />
            <CheckBox x:Name="TicketOnlyCheck" Content="فقط Custom Number Ticket چاپ شود؛ Print Card چاپ نشود" Margin="0,0,0,14" />
            <Button x:Name="SavePrintSettingsButton" Content="ذخیره تنظیمات چاپ" Height="42" Margin="0,0,0,16" HorizontalAlignment="Stretch" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" Click="SavePrintSettingsButton_Click" />
            <Border Padding="14" Background="#EFF8FF" BorderBrush="#B2DDFF" BorderThickness="1" CornerRadius="9">
              <TextBlock Text="این تنظیمات با همان EGM در پنل وب همگام هستند. در حالت Custom Number Ticket، پس از ورود موفق ابتدا شماره پرسیده می‌شود. با فعال‌کردن «فقط Custom Number Ticket»، Print Card چاپ نمی‌شود." Foreground="#175CD3" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" Margin="24" FlowDirection="LeftToRight">
        <Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="12" Padding="32">
          <StackPanel Width="520" HorizontalAlignment="Right" VerticalAlignment="Top" FlowDirection="RightToLeft">
            <TextBlock Text="تنظیمات" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="رویداد مورد استفاده در کنترل مهمان را انتخاب کنید." Margin="0,5,0,28" Foreground="#667085" />
            <TextBlock Text="انتخاب EGM" FontWeight="SemiBold" />
            <ComboBox x:Name="EventCombo" Height="44" Margin="0,8,0,18" DisplayMemberPath="DisplayName" SelectionChanged="EventCombo_SelectionChanged" />
            <Border Padding="16" Background="#F9FAFB" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10">
              <StackPanel Orientation="Horizontal">
                <Border x:Name="SelectedEventLogoBorder" Width="52" Height="52" CornerRadius="12" Background="{DynamicResource PrimaryBrush}">
                  <Grid>
                    <TextBlock x:Name="SelectedEventLogoText" Text="EGM" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                    <Image x:Name="SelectedEventLogoImage" Visibility="Collapsed" Stretch="Uniform" Margin="4" />
                  </Grid>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="رویداد انتخاب‌شده" Foreground="#667085" FontSize="11" />
                  <TextBlock x:Name="SelectedEventNameText" Text="رویدادی انتخاب نشده است" Margin="0,4,0,0" FontSize="17" FontWeight="Bold" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
