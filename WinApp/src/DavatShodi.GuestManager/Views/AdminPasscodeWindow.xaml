<Window x:Class="DavatShodi.GuestManager.Views.AdminPasscodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Passcode" Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="{StaticResource PanelFont}" Background="#F7F9FC">
  <Border Margin="18" Padding="22" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="14">
    <StackPanel>
      <TextBlock Text="Admin Passcode" FontSize="21" FontWeight="Bold" />
      <TextBlock x:Name="PromptText" Margin="0,7,0,16" Foreground="#667085" TextWrapping="Wrap" />
      <PasswordBox x:Name="PasscodeBox" Height="50" MaxLength="6" FontSize="22" FlowDirection="LeftToRight"
                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center" PreviewTextInput="PasscodeBox_PreviewTextInput" />
      <TextBlock x:Name="ErrorText" Margin="0,6,0,0" Foreground="#D92D20" Visibility="Collapsed" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
        <Button Content="تأیید" Width="140" MinHeight="44" Padding="16,8" IsDefault="True" Click="Confirm_Click"
                Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" />
        <Button Content="انصراف" Width="95" MinHeight="44" Padding="16,8" Margin="10,0,0,0" IsCancel="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
