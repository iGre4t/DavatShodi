<Window x:Class="DavatShodi.GuestManager.Views.RegisterUninvitedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ثبت مهمان ناخوانده | EGM" Width="700" Height="720" MinWidth="620" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" FlowDirection="LeftToRight"
        FontFamily="{StaticResource PanelFont}" Background="#F5F6F8"
        Icon="/DavatShodi.GuestManager;component/Assets/Brand/HamrahIcon.ico">
  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
    <Style x:Key="FieldText" TargetType="TextBox"><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="9,6" /><Setter Property="BorderBrush" Value="#D0D5DD" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style x:Key="FieldCombo" TargetType="ComboBox"><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="7,4" /><Setter Property="BorderBrush" Value="#D0D5DD" /><Setter Property="IsEditable" Value="True" /></Style>
  </Window.Resources>

  <Grid FlowDirection="RightToLeft">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Padding="22,16" Background="White" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Text="ثبت در رویداد و بازه فعال" Foreground="#667085" FontSize="11" />
        <TextBlock Text="افزودن مهمان ناخوانده" Margin="0,4,0,0" FontSize="22" FontWeight="Bold" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0"><TextBlock Text="نام *" Style="{StaticResource FieldLabel}" /><TextBox x:Name="FirstNameBox" Style="{StaticResource FieldText}" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="نام خانوادگی *" Style="{StaticResource FieldLabel}" /><TextBox x:Name="LastNameBox" Style="{StaticResource FieldText}" /></StackPanel>
        </Grid>
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0"><TextBlock Text="کد ملی *" Style="{StaticResource FieldLabel}" /><TextBox x:Name="NationalIdBox" Style="{StaticResource FieldText}" MaxLength="10" FlowDirection="LeftToRight" TextAlignment="Center" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="کد پرسنلی" Style="{StaticResource FieldLabel}" /><TextBox x:Name="WorkIdBox" Style="{StaticResource FieldText}" FlowDirection="LeftToRight" TextAlignment="Center" /></StackPanel>
        </Grid>
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0"><TextBlock Text="شماره همراه" Style="{StaticResource FieldLabel}" /><TextBox x:Name="PhoneBox" Style="{StaticResource FieldText}" FlowDirection="LeftToRight" TextAlignment="Center" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="جنسیت" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="GenderCombo" Style="{StaticResource FieldCombo}" /></StackPanel>
        </Grid>

        <Border Margin="0,16,0,2" Padding="13" Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="9">
          <CheckBox x:Name="OutsideOrganizationCheck" Content="خارج از سازمان / اداره نامشخص" FontWeight="SemiBold" Checked="OutsideOrganizationCheck_Changed" Unchecked="OutsideOrganizationCheck_Changed" />
        </Border>

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0"><TextBlock Text="معاونت *" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="DeputyCombo" Style="{StaticResource FieldCombo}" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="اداره کل *" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="GeneralDepartmentCombo" Style="{StaticResource FieldCombo}" /></StackPanel>
        </Grid>
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0"><TextBlock Text="اداره *" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="DepartmentCombo" Style="{StaticResource FieldCombo}" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="سطح پستی" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="PostalLevelCombo" Style="{StaticResource FieldCombo}" /></StackPanel>
        </Grid>
        <TextBlock x:Name="ValidationText" Margin="0,16,0,0" Foreground="#C72C41" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="18,12" Background="White" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="RightToLeft">
        <Button Width="130" Height="40" Content="ثبت مهمان" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" IsDefault="True" Click="SaveButton_Click" />
        <Button Width="90" Height="40" Margin="10,0,0,0" Content="انصراف" Background="White" BorderBrush="#D0D5DD" IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
