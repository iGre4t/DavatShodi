<Window x:Class="DavatShodi.GuestManager.Views.GuestDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="جزئیات مهمان | EGM" Width="760" Height="650" MinWidth="650" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" FlowDirection="LeftToRight"
        FontFamily="{StaticResource PanelFont}" Background="#F5F6F8"
        Icon="/DavatShodi.GuestManager;component/Assets/Brand/HamrahIcon.ico">
  <Window.Resources>
    <Style x:Key="DetailLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#667085" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style x:Key="DetailValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#101828" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DetailItem" TargetType="Border">
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="5" />
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#E4E7EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
  </Window.Resources>

  <Grid FlowDirection="RightToLeft">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Padding="22,16" Background="White" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Text="اطلاعات مهمان و حضور" Foreground="#667085" FontSize="11" />
        <TextBlock Text="{Binding DisplayName}" Margin="0,4,0,0" FontSize="22" FontWeight="Bold" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="17" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="مشخصات مهمان" Margin="5,0,5,7" FontSize="16" FontWeight="Bold" />
        <UniformGrid Columns="2">
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="نوع مهمان" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding GuestTypeLabel}" Style="{StaticResource DetailValue}" /></StackPanel></Border>
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="موقعیت سازمانی" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding OrganizationLabel}" Style="{StaticResource DetailValue}" /></StackPanel></Border>
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="کد ملی" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding NationalId, TargetNullValue=—}" Style="{StaticResource DetailValue}" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel></Border>
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="کد پرسنلی" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding WorkId, TargetNullValue=—}" Style="{StaticResource DetailValue}" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel></Border>
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="شماره همراه" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding PhoneNumber, TargetNullValue=—}" Style="{StaticResource DetailValue}" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel></Border>
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="شماره مهمان" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding GuestNumber, TargetNullValue=—}" Style="{StaticResource DetailValue}" /></StackPanel></Border>
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="معاونت" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding Deputy, TargetNullValue=—}" Style="{StaticResource DetailValue}" /></StackPanel></Border>
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="اداره کل" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding GeneralDepartment, TargetNullValue=—}" Style="{StaticResource DetailValue}" /></StackPanel></Border>
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="اداره" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding Department, TargetNullValue=—}" Style="{StaticResource DetailValue}" /></StackPanel></Border>
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="جنسیت / سطح پستی" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding GenderPostalLabel}" Style="{StaticResource DetailValue}" /></StackPanel></Border>
        </UniformGrid>

        <TextBlock Text="اطلاعات حضور در بازه" Margin="5,18,5,7" FontSize="16" FontWeight="Bold" />
        <UniformGrid Columns="2">
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="بازه" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding PeriodLabel}" Style="{StaticResource DetailValue}" /></StackPanel></Border>
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="Number of Ticket" Style="{StaticResource DetailLabel}" FlowDirection="LeftToRight" /><TextBlock Text="{Binding NumberOfTicket, TargetNullValue=—}" Style="{StaticResource DetailValue}" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel></Border>
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="وضعیت فعلی حضور" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding AttendanceStateLabel}" Style="{StaticResource DetailValue}" /></StackPanel></Border>
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="نوع حضور" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding PresenceLabel}" Style="{StaticResource DetailValue}" /></StackPanel></Border>
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="وضعیت آخرین بررسی" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding StatusLabel}" Style="{StaticResource DetailValue}" /></StackPanel></Border>
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="زمان ورود" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding EntryAt}" Style="{StaticResource DetailValue}" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel></Border>
          <Border Style="{StaticResource DetailItem}"><StackPanel><TextBlock Text="زمان خروج" Style="{StaticResource DetailLabel}" /><TextBlock Text="{Binding QuitAt}" Style="{StaticResource DetailValue}" FlowDirection="LeftToRight" TextAlignment="Right" /></StackPanel></Border>
        </UniformGrid>

        <Border Margin="5,18,5,5" Padding="15" Background="#F8FAFC" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <TextBlock Text="نتیجه ثبت‌شده" Foreground="#667085" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="{Binding Message}" Margin="0,7,0,0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="18,12" Background="White" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0">
      <Button Width="100" Height="38" HorizontalAlignment="Left" Content="بستن" Background="White" BorderBrush="#D0D5DD" IsCancel="True" Click="CloseButton_Click" />
    </Border>
  </Grid>
</Window>
