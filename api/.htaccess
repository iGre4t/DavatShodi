Options -Indexes

# Keep credentials, their backup copies, and the CLI bot runner private.
# PHP includes and CLI execution still work; telegram-webhook.php remains public.
<FilesMatch "(?i)^(config(?:\.[a-z0-9_-]+)*|telegram\.config(?:\.[a-z0-9_-]+)*|schema|users|telegram-bot)\.php(?:[.~].*)?$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent direct download of SQL exports.
<FilesMatch "\.sql$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
